# Add these two location blocks inside the existing nginx `server {}` block
# that serves pontsho-mbizo.com / the nip.io host. nginx config lives on the
# VM directly (not in this git repo) — this file documents what to add, you
# apply it by hand.
#
# One-time setup on the VM:
#
#   sudo apt-get install -y apache2-utils   # for htpasswd, if not already present
#   sudo htpasswd -c /etc/nginx/.htpasswd_pontsho_admin pontsho
#   # (drop -c on subsequent users so you don't overwrite the file)
#
# IMPORTANT: only put this behind HTTPS in practice — basic auth sends the
# password on every request, base64-encoded (not encrypted). If the site is
# still on the http-only nip.io host, get TLS working first (certbot) before
# actually using /admin day to day. It's fine to add the config now either
# way; just don't type your password in over plain HTTP.

location /admin/ {
    auth_basic           "pontshoOS admin";
    auth_basic_user_file /etc/nginx/.htpasswd_pontsho_admin;

    alias      /var/www/pontsho-mbizo/admin/;
    index      index.html;
    try_files  $uri $uri/ =404;
}

location /admin/api/ {
    auth_basic           "pontshoOS admin";
    auth_basic_user_file /etc/nginx/.htpasswd_pontsho_admin;

    # trailing slash on both sides strips the /admin/api/ prefix, so
    # /admin/api/save reaches the backend as POST /save
    proxy_pass         http://127.0.0.1:8787/;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    client_max_body_size 2m;
}

# content.json itself stays PUBLIC (no auth_basic) — it's the same portfolio
# data already visible on the live site, and index.html needs to fetch it
# unauthenticated. It's served as a plain static file alongside index.html,
# nothing extra to configure for that — it just needs to exist at
# /var/www/pontsho-mbizo/content.json (deploy.sh seeds it there on first run).

# User-level systemd unit for the pontshoOS admin backend.
#
# Install as: ~/.config/systemd/user/pontsho-admin.service (as the `ubuntu`
# deploy user — the same one the CI deploy key logs in as), then:
#
#   loginctl enable-linger ubuntu     # so it keeps running without a login session
#   systemctl --user daemon-reload
#   systemctl --user enable --now pontsho-admin.service
#
# deploy.sh will `systemctl --user restart pontsho-admin.service` on every
# deploy if this unit is enabled, so code changes to admin/server.py take
# effect automatically. It intentionally runs as a --user unit (not system-
# wide) so the restricted deploy key never needs sudo.

[Unit]
Description=pontshoOS admin content backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/apps/portfolio-website/admin
Environment=CONTENT_PATH=/var/www/pontsho-mbizo/content.json
Environment=BIND=127.0.0.1
Environment=PORT=8787
ExecStart=/usr/bin/python3 %h/apps/portfolio-website/admin/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
